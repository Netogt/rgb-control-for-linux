diff --git a/Controllers/PichauAurumController/PichauAurumController.cpp b/Controllers/PichauAurumController/PichauAurumController.cpp
new file mode 100644
index 0000000..0d79737
--- /dev/null
+++ b/Controllers/PichauAurumController/PichauAurumController.cpp
@@ -0,0 +1,270 @@
+/*---------------------------------------------------------*\
+| PichauAurumController.cpp                                 |
+|                                                           |
+|   Driver for Pichau Aurum keyboards (SDCINNOVATION        |
+|   36AE:FE9C), lighting interface 2                        |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-3.0-only                   |
+\*---------------------------------------------------------*/
+
+#include <chrono>
+#include <cstring>
+#include "LogManager.h"
+#include "PichauAurumController.h"
+#include "StringUtils.h"
+
+using namespace std::chrono_literals;
+
+#define PICHAU_AURUM_CMD_PREFIX         0x06
+#define PICHAU_AURUM_CMD_GET_CURRENT    0x0A
+#define PICHAU_AURUM_CMD_SET_MODE       0x0B
+#define PICHAU_AURUM_CMD_GET_MODE       0x16
+#define PICHAU_AURUM_REPLY_PREFIX       0xAA
+#define PICHAU_AURUM_SETTINGS_OFFSET    7
+#define PICHAU_AURUM_SETTINGS_LENGTH    9
+
+/*---------------------------------------------------------*\
+| Time without changes before a write goes to the keyboard  |
+\*---------------------------------------------------------*/
+#define PICHAU_AURUM_WRITE_DELAY        400ms
+
+bool PichauAurumModeSettings::operator==(const PichauAurumModeSettings& o) const
+{
+    return(memcmp(this, &o, sizeof(PichauAurumModeSettings)) == 0);
+}
+
+static void SettingsToBytes(const PichauAurumModeSettings& s, unsigned char* out)
+{
+    out[0] = s.mode;
+    out[1] = s.brightness;
+    out[2] = s.speed;
+    out[3] = s.direction;
+    out[4] = s.mono;
+    out[5] = s.reserved;
+    out[6] = s.hue;
+    out[7] = s.saturation;
+    out[8] = s.value;
+}
+
+PichauAurumController::PichauAurumController(hid_device* dev_handle, const char* path, std::string dev_name)
+{
+    dev                 = dev_handle;
+    location            = path;
+    name                = dev_name;
+    pending_valid       = false;
+    stop_writer         = false;
+    last_written_valid  = false;
+    memset(&pending, 0, sizeof(pending));
+    memset(&last_written, 0, sizeof(last_written));
+
+    writer_thread       = std::thread(&PichauAurumController::WriterThread, this);
+}
+
+PichauAurumController::~PichauAurumController()
+{
+    {
+        std::lock_guard<std::mutex> lock(pending_mutex);
+        stop_writer = true;
+    }
+    pending_cv.notify_all();
+    writer_thread.join();
+
+    hid_close(dev);
+}
+
+std::string PichauAurumController::GetDeviceLocation()
+{
+    return("HID: " + location);
+}
+
+std::string PichauAurumController::GetNameString()
+{
+    return(name);
+}
+
+std::string PichauAurumController::GetSerialString()
+{
+    wchar_t serial_string[128];
+    int ret = hid_get_serial_number_string(dev, serial_string, 128);
+
+    if(ret != 0)
+    {
+        return("");
+    }
+
+    return(StringUtils::wstring_to_string(serial_string));
+}
+
+/*---------------------------------------------------------*\
+| Sends a 64-byte command (no report ID) and waits for the  |
+| reply that starts with AA <expect>. Retries up to 3 times |
+| because the keyboard drops commands when busy.            |
+\*---------------------------------------------------------*/
+bool PichauAurumController::Command(const unsigned char* data, int length, unsigned char expect, unsigned char* reply)
+{
+    std::lock_guard<std::mutex> lock(hid_mutex);
+
+    unsigned char buf[PICHAU_AURUM_REPORT_SIZE + 1];
+
+    memset(buf, 0, sizeof(buf));
+    memcpy(&buf[1], data, length);
+
+    for(int attempt = 0; attempt < 3; attempt++)
+    {
+        if(hid_write(dev, buf, sizeof(buf)) < 0)
+        {
+            continue;
+        }
+
+        for(int read = 0; read < 8; read++)
+        {
+            int ret = hid_read_timeout(dev, reply, PICHAU_AURUM_REPORT_SIZE, 500);
+
+            if(ret <= 0)
+            {
+                break;
+            }
+
+            if(reply[0] == PICHAU_AURUM_REPLY_PREFIX && reply[1] == expect)
+            {
+                return(true);
+            }
+        }
+    }
+
+    LOG_WARNING("[%s] No reply from keyboard to command %02X", name.c_str(), data[1]);
+    return(false);
+}
+
+bool PichauAurumController::ReadCurrentMode(unsigned char* mode)
+{
+    unsigned char cmd[]   = { PICHAU_AURUM_CMD_PREFIX, PICHAU_AURUM_CMD_GET_CURRENT };
+    unsigned char reply[PICHAU_AURUM_REPORT_SIZE];
+
+    if(!Command(cmd, sizeof(cmd), PICHAU_AURUM_CMD_GET_CURRENT, reply))
+    {
+        return(false);
+    }
+
+    *mode = reply[PICHAU_AURUM_SETTINGS_OFFSET];
+    return(true);
+}
+
+bool PichauAurumController::ReadModeSettings(unsigned char mode, PichauAurumModeSettings* settings)
+{
+    unsigned char cmd[]   = { PICHAU_AURUM_CMD_PREFIX, PICHAU_AURUM_CMD_GET_MODE, 0x00, 0x00, 0x00, 0x01, 0x00, mode };
+    unsigned char reply[PICHAU_AURUM_REPORT_SIZE];
+
+    if(!Command(cmd, sizeof(cmd), PICHAU_AURUM_CMD_GET_MODE, reply))
+    {
+        return(false);
+    }
+
+    const unsigned char* s = &reply[PICHAU_AURUM_SETTINGS_OFFSET];
+
+    if(s[0] != mode)
+    {
+        LOG_WARNING("[%s] Settings reply for mode %d came back for mode %d", name.c_str(), mode, s[0]);
+        return(false);
+    }
+
+    settings->mode       = s[0];
+    settings->brightness = s[1];
+    settings->speed      = s[2];
+    settings->direction  = s[3];
+    settings->mono       = s[4];
+    settings->reserved   = s[5];
+    settings->hue        = s[6];
+    settings->saturation = s[7];
+    settings->value      = s[8];
+
+    return(true);
+}
+
+bool PichauAurumController::WriteModeSettings(const PichauAurumModeSettings& settings)
+{
+    unsigned char cmd[PICHAU_AURUM_SETTINGS_OFFSET + PICHAU_AURUM_SETTINGS_LENGTH] =
+        { PICHAU_AURUM_CMD_PREFIX, PICHAU_AURUM_CMD_SET_MODE, 0x0B, 0x00, 0x00, 0x01, 0x00 };
+    unsigned char reply[PICHAU_AURUM_REPORT_SIZE];
+
+    SettingsToBytes(settings, &cmd[PICHAU_AURUM_SETTINGS_OFFSET]);
+
+    if(!Command(cmd, sizeof(cmd), PICHAU_AURUM_CMD_SET_MODE, reply))
+    {
+        return(false);
+    }
+
+    /*-----------------------------------------------------*\
+    | The keyboard echoes the settings it accepted          |
+    \*-----------------------------------------------------*/
+    if(memcmp(&reply[PICHAU_AURUM_SETTINGS_OFFSET], &cmd[PICHAU_AURUM_SETTINGS_OFFSET], PICHAU_AURUM_SETTINGS_LENGTH) != 0)
+    {
+        LOG_WARNING("[%s] Keyboard did not accept mode %d settings", name.c_str(), settings.mode);
+        return(false);
+    }
+
+    return(true);
+}
+
+void PichauAurumController::QueueModeSettings(const PichauAurumModeSettings& settings)
+{
+    {
+        std::lock_guard<std::mutex> lock(pending_mutex);
+        pending       = settings;
+        pending_valid = true;
+    }
+    pending_cv.notify_all();
+}
+
+void PichauAurumController::WriterThread()
+{
+    std::unique_lock<std::mutex> lock(pending_mutex);
+
+    while(!stop_writer)
+    {
+        pending_cv.wait(lock, [this]{ return(stop_writer || pending_valid); });
+
+        if(stop_writer)
+        {
+            break;
+        }
+
+        /*-------------------------------------------------*\
+        | Wait until no new settings arrive for the delay   |
+        \*-------------------------------------------------*/
+        PichauAurumModeSettings snapshot = pending;
+
+        while(!stop_writer && pending_cv.wait_for(lock, PICHAU_AURUM_WRITE_DELAY, [&]{ return(stop_writer || !(pending == snapshot)); }))
+        {
+            snapshot = pending;
+        }
+
+        pending_valid = false;
+
+        if(last_written_valid && snapshot == last_written)
+        {
+            continue;
+        }
+
+        lock.unlock();
+        bool ok = WriteModeSettings(snapshot);
+        lock.lock();
+
+        if(ok)
+        {
+            last_written       = snapshot;
+            last_written_valid = true;
+        }
+    }
+
+    /*-----------------------------------------------------*\
+    | Flush a write still pending at shutdown               |
+    \*-----------------------------------------------------*/
+    if(pending_valid && !(last_written_valid && pending == last_written))
+    {
+        PichauAurumModeSettings snapshot = pending;
+        lock.unlock();
+        WriteModeSettings(snapshot);
+    }
+}
