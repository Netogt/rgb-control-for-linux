+++ b/Controllers/PichauAurumController/PichauAurumControllerDetect.cpp
@@ -0,0 +1,38 @@
+/*---------------------------------------------------------*\
+| PichauAurumControllerDetect.cpp                           |
+|                                                           |
+|   Detector for Pichau Aurum keyboards                     |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-3.0-only                   |
+\*---------------------------------------------------------*/
+
+#include <hidapi.h>
+#include "DetectionManager.h"
+#include "PichauAurumController.h"
+#include "RGBController_PichauAurum.h"
+
+#define SDCINNOVATION_VID           0x36AE
+#define PICHAU_AURUM_PID            0xFE9C
+#define PICHAU_AURUM_INTERFACE      2
+#define PICHAU_AURUM_USAGE_PAGE     0xFF00
+
+DetectedControllers DetectPichauAurumKeyboards(hid_device_info* info, const std::string& name)
+{
+    DetectedControllers detected_controllers;
+    hid_device*         dev;
+
+    dev = hid_open_path(info->path);
+
+    if(dev)
+    {
+        PichauAurumController*      controller     = new PichauAurumController(dev, info->path, name);
+        RGBController_PichauAurum*  rgb_controller = new RGBController_PichauAurum(controller);
+
+        detected_controllers.push_back(rgb_controller);
+    }
+
+    return(detected_controllers);
+}
+
+REGISTER_HID_DETECTOR_IP("Pichau Aurum Keyboard", DetectPichauAurumKeyboards, SDCINNOVATION_VID, PICHAU_AURUM_PID, PICHAU_AURUM_INTERFACE, PICHAU_AURUM_USAGE_PAGE);
diff --git a/Controllers/PichauAurumController/RGBController_PichauAurum.cpp b/Controllers/PichauAurumController/RGBController_PichauAurum.cpp
new file mode 100644
index 0000000..2e58aca
--- /dev/null
+++ b/Controllers/PichauAurumController/RGBController_PichauAurum.cpp
@@ -0,0 +1,292 @@
+/*---------------------------------------------------------*\
+| RGBController_PichauAurum.cpp                             |
+|                                                           |
+|   RGBController for Pichau Aurum keyboards                |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-3.0-only                   |
+\*---------------------------------------------------------*/
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include "RGBController_PichauAurum.h"
+
+/**------------------------------------------------------------------*\
+    @name Pichau Aurum
+    @category Keyboard
+    @type USB
+    @save :white_check_mark:
+    @direct :x:
+    @effects :white_check_mark:
+    @detectors DetectPichauAurumKeyboards
+    @comment Effects run on the keyboard. Every change is written to
+        the keyboard flash, so updates are delayed until settings stop
+        changing. Per-key colors are not supported yet.
+\*-------------------------------------------------------------------*/
+
+#define PICHAU_AURUM_BRIGHTNESS_STEPS   10      /* UI scale                     */
+#define PICHAU_AURUM_HW_BRIGHTNESS_MAX  4       /* keyboard brightness byte     */
+#define PICHAU_AURUM_SPEED_MAX          2
+
+struct PichauAurumModeInfo
+{
+    const char*     name;
+    unsigned char   value;
+    bool            single_color;   /* supports a user-chosen color     */
+    unsigned char   mono_min;       /* lowest visible value in mono     */
+};
+
+/*---------------------------------------------------------*\
+| In single-color mode the firmware ignores its brightness  |
+| byte, so brightness is applied to the color value. The    |
+| minimum visible value differs per effect.                 |
+\*---------------------------------------------------------*/
+static const PichauAurumModeInfo mode_info[] =
+{
+    { "Off",                    PICHAU_AURUM_MODE_OFF,           false, 0  },
+    { "Static",                 PICHAU_AURUM_MODE_STATIC,        true,  12 },
+    { "Breathing",              PICHAU_AURUM_MODE_BREATH,        true,  35 },
+    { "Spin",                   PICHAU_AURUM_MODE_SPIN,          false, 0  },
+    { "Color Cycle",            PICHAU_AURUM_MODE_COLOR_LOOP,    false, 0  },
+    { "Stream",                 PICHAU_AURUM_MODE_STREAM,        true,  35 },
+    { "Bloom",                  PICHAU_AURUM_MODE_BLOOM,         true,  16 },
+    { "Up-Down Wave",           PICHAU_AURUM_MODE_UD_WAVE,       true,  16 },
+    { "Cross",                  PICHAU_AURUM_MODE_CROSS,         true,  16 },
+    { "Rain",                   PICHAU_AURUM_MODE_RAIN,          true,  12 },
+    { "Meteor",                 PICHAU_AURUM_MODE_METEOR,        true,  35 },
+    { "Reactive Spread",        PICHAU_AURUM_MODE_TRIG_SPREAD,   true,  16 },
+    { "Reactive Spread Reverse",PICHAU_AURUM_MODE_TRIG_SPREAD_R, true,  16 },
+    { "Reactive",               PICHAU_AURUM_MODE_TRIG_SINGLE,   true,  12 },
+    { "Sudoku",                 PICHAU_AURUM_MODE_SUDOKU,        true,  12 },
+    { "Tide",                   PICHAU_AURUM_MODE_TIDE,          true,  35 },
+};
+
+static void RGBToHSV(RGBColor color, unsigned char* h, unsigned char* s, unsigned char* v)
+{
+    double r  = RGBGetRValue(color) / 255.0;
+    double g  = RGBGetGValue(color) / 255.0;
+    double b  = RGBGetBValue(color) / 255.0;
+    double mx = std::max({ r, g, b });
+    double mn = std::min({ r, g, b });
+    double d  = mx - mn;
+    double hue = 0.0;
+
+    if(d > 0.0)
+    {
+        if(mx == r)      hue = std::fmod((g - b) / d, 6.0);
+        else if(mx == g) hue = (b - r) / d + 2.0;
+        else             hue = (r - g) / d + 4.0;
+        hue /= 6.0;
+        if(hue < 0.0)    hue += 1.0;
+    }
+
+    *h = (unsigned char)((int)std::lround(hue * 255.0) % 256);
+    *s = (unsigned char)std::lround(mx > 0.0 ? (d / mx) * 255.0 : 0.0);
+    *v = (unsigned char)std::lround(mx * 255.0);
+}
+
+static RGBColor HSVToRGB(unsigned char h, unsigned char s, unsigned char v)
+{
+    double hue = (h / 255.0) * 6.0;
+    double sat = s / 255.0;
+    double val = v / 255.0;
+    int    i   = (int)std::floor(hue) % 6;
+    double f   = hue - std::floor(hue);
+    double p   = val * (1.0 - sat);
+    double q   = val * (1.0 - f * sat);
+    double t   = val * (1.0 - (1.0 - f) * sat);
+    double r = 0, g = 0, b = 0;
+
+    switch(i)
+    {
+        case 0: r = val; g = t;   b = p;   break;
+        case 1: r = q;   g = val; b = p;   break;
+        case 2: r = p;   g = val; b = t;   break;
+        case 3: r = p;   g = q;   b = val; break;
+        case 4: r = t;   g = p;   b = val; break;
+        default:r = val; g = p;   b = q;   break;
+    }
+
+    return(ToRGBColor((unsigned char)std::lround(r * 255), (unsigned char)std::lround(g * 255), (unsigned char)std::lround(b * 255)));
+}
+
+/*---------------------------------------------------------*\
+| Maps UI brightness 1..10 to a color value between the     |
+| effect's minimum visible value and 255 (perceptual curve) |
+\*---------------------------------------------------------*/
+static unsigned char MonoLevel(unsigned char mono_min, unsigned int level)
+{
+    if(level == 0 || mono_min == 0)
+    {
+        return(level == 0 ? 0 : 255);
+    }
+
+    double exponent = (double)(level - 1) / (PICHAU_AURUM_BRIGHTNESS_STEPS - 1);
+    return((unsigned char)std::lround(mono_min * std::pow(255.0 / mono_min, exponent)));
+}
+
+RGBController_PichauAurum::RGBController_PichauAurum(PichauAurumController* controller_ptr)
+{
+    controller              = controller_ptr;
+
+    name                    = controller->GetNameString();
+    vendor                  = "Pichau";
+    type                    = DEVICE_TYPE_KEYBOARD;
+    description             = "Pichau Aurum Keyboard (SDCINNOVATION 36AE:FE9C)";
+    location                = controller->GetDeviceLocation();
+    serial                  = controller->GetSerialString();
+
+    unsigned char current_mode = PICHAU_AURUM_MODE_STATIC;
+
+    for(const PichauAurumModeInfo& info : mode_info)
+    {
+        /*-------------------------------------------------*\
+        | Start from what the keyboard has stored, so the   |
+        | unknown bytes (direction, reserved) are preserved |
+        \*-------------------------------------------------*/
+        PichauAurumModeSettings& s = stored[info.value];
+
+        if(!controller->ReadModeSettings(info.value, &s))
+        {
+            s            = { info.value, 3, 1, 1, (unsigned char)(info.single_color ? 1 : 0), 0xFF, 0, 255, 255 };
+        }
+
+        mode m;
+        m.name              = info.name;
+        m.value             = info.value;
+        m.flags             = MODE_FLAG_AUTOMATIC_SAVE;
+        m.color_mode        = MODE_COLORS_NONE;
+
+        if(info.value != PICHAU_AURUM_MODE_OFF)
+        {
+            m.flags        |= MODE_FLAG_HAS_SPEED | MODE_FLAG_HAS_BRIGHTNESS;
+            m.speed_min     = 0;
+            m.speed_max     = PICHAU_AURUM_SPEED_MAX;
+            m.speed         = std::min<unsigned int>(s.speed, PICHAU_AURUM_SPEED_MAX);
+            m.brightness_min= 0;
+            m.brightness_max= PICHAU_AURUM_BRIGHTNESS_STEPS;
+            m.brightness    = (unsigned int)std::lround(s.brightness * (double)PICHAU_AURUM_BRIGHTNESS_STEPS / PICHAU_AURUM_HW_BRIGHTNESS_MAX);
+        }
+
+        if(info.single_color && s.mono)
+        {
+            /*---------------------------------------------*\
+            | In single-color mode the visible brightness   |
+            | is the color value, not the brightness byte:  |
+            | pick the level whose value is closest to it   |
+            \*---------------------------------------------*/
+            unsigned int best = PICHAU_AURUM_BRIGHTNESS_STEPS;
+            int          diff = 256;
+
+            for(unsigned int level = 0; level <= PICHAU_AURUM_BRIGHTNESS_STEPS; level++)
+            {
+                int d = std::abs((int)MonoLevel(info.mono_min, level) - (int)s.value);
+                if(d < diff)
+                {
+                    diff = d;
+                    best = level;
+                }
+            }
+
+            m.brightness    = best;
+        }
+
+        if(info.single_color)
+        {
+            m.flags        |= MODE_FLAG_HAS_MODE_SPECIFIC_COLOR | MODE_FLAG_HAS_RANDOM_COLOR;
+            m.colors_min    = 1;
+            m.colors_max    = 1;
+            m.colors.push_back(HSVToRGB(s.hue, s.saturation, 255));
+            m.color_mode    = s.mono ? MODE_COLORS_MODE_SPECIFIC : MODE_COLORS_RANDOM;
+        }
+
+        modes.push_back(m);
+    }
+
+    controller->ReadCurrentMode(&current_mode);
+
+    active_mode = 0;
+    for(std::size_t i = 0; i < modes.size(); i++)
+    {
+        if(modes[i].value == current_mode)
+        {
+            active_mode = (int)i;
+        }
+    }
+
+    SetupZones();
+}
+
+RGBController_PichauAurum::~RGBController_PichauAurum()
+{
+    Shutdown();
+    delete controller;
+}
+
+void RGBController_PichauAurum::SetupZones()
+{
+    /*-----------------------------------------------------*\
+    | Whole keyboard as one LED until the V80 key map is    |
+    | known (per-key colors need it)                        |
+    \*-----------------------------------------------------*/
+    zone keyboard_zone;
+    keyboard_zone.name          = "Keyboard";
+    keyboard_zone.type          = ZONE_TYPE_SINGLE;
+    keyboard_zone.leds_min      = 1;
+    keyboard_zone.leds_max      = 1;
+    keyboard_zone.leds_count    = 1;
+    zones.push_back(keyboard_zone);
+
+    led keyboard_led;
+    keyboard_led.name           = "Keyboard";
+    leds.push_back(keyboard_led);
+
+    SetupColors();
+}
+
+void RGBController_PichauAurum::DeviceUpdateLEDs()
+{
+    /*-----------------------------------------------------*\
+    | No direct mode; colors are part of each effect        |
+    \*-----------------------------------------------------*/
+}
+
+void RGBController_PichauAurum::DeviceUpdateZoneLEDs(int /*zone*/)
+{
+}
+
+void RGBController_PichauAurum::DeviceUpdateSingleLED(int /*led*/)
+{
+}
+
+void RGBController_PichauAurum::DeviceUpdateMode()
+{
+    const mode&                 m    = modes[active_mode];
+    const PichauAurumModeInfo&  info = mode_info[active_mode];
+    PichauAurumModeSettings     s    = stored[m.value];
+
+    if(m.value != PICHAU_AURUM_MODE_OFF)
+    {
+        unsigned int level  = std::min<unsigned int>(m.brightness, PICHAU_AURUM_BRIGHTNESS_STEPS);
+        s.speed             = (unsigned char)std::min<unsigned int>(m.speed, PICHAU_AURUM_SPEED_MAX);
+        s.brightness        = level == 0 ? 0 : (unsigned char)std::max<long>(1, std::lround(level * (double)PICHAU_AURUM_HW_BRIGHTNESS_MAX / PICHAU_AURUM_BRIGHTNESS_STEPS));
+
+        if(info.single_color && m.color_mode == MODE_COLORS_MODE_SPECIFIC && !m.colors.empty())
+        {
+            unsigned char h, sat, v;
+            RGBToHSV(m.colors[0], &h, &sat, &v);
+            s.mono          = 1;
+            s.hue           = h;
+            s.saturation    = sat;
+            s.value         = (unsigned char)std::lround(v / 255.0 * MonoLevel(info.mono_min, level));
+        }
+        else if(info.single_color)
+        {
+            s.mono          = 0;
+        }
+    }
+
+    stored[m.value] = s;
+    controller->QueueModeSettings(s);
+}
