new file mode 100644
index 0000000..76a0362
--- /dev/null
+++ b/Controllers/PichauAurumController/PichauAurumController.h
@@ -0,0 +1,106 @@
+/*---------------------------------------------------------*\
+| PichauAurumController.h                                   |
+|                                                           |
+|   Driver for Pichau Aurum keyboards (SDCINNOVATION        |
+|   36AE:FE9C), lighting interface 2                        |
+|                                                           |
+|   Protocol documented by the OpenAurum project            |
+|   (github.com/its-danilo/openaurum), captured from the    |
+|   official Windows software.                              |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-3.0-only                   |
+\*---------------------------------------------------------*/
+
+#pragma once
+
+#include <condition_variable>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <hidapi.h>
+
+#define PICHAU_AURUM_REPORT_SIZE    64
+#define PICHAU_AURUM_MODE_COUNT     16      /* 0 (off) .. 15; 16 (per-key) not exposed */
+
+enum
+{
+    PICHAU_AURUM_MODE_OFF           = 0,
+    PICHAU_AURUM_MODE_STATIC        = 1,
+    PICHAU_AURUM_MODE_BREATH        = 2,
+    PICHAU_AURUM_MODE_SPIN          = 3,
+    PICHAU_AURUM_MODE_COLOR_LOOP    = 4,
+    PICHAU_AURUM_MODE_STREAM        = 5,
+    PICHAU_AURUM_MODE_BLOOM         = 6,
+    PICHAU_AURUM_MODE_UD_WAVE       = 7,
+    PICHAU_AURUM_MODE_CROSS         = 8,
+    PICHAU_AURUM_MODE_RAIN          = 9,
+    PICHAU_AURUM_MODE_METEOR        = 10,
+    PICHAU_AURUM_MODE_TRIG_SPREAD   = 11,
+    PICHAU_AURUM_MODE_TRIG_SPREAD_R = 12,
+    PICHAU_AURUM_MODE_TRIG_SINGLE   = 13,
+    PICHAU_AURUM_MODE_SUDOKU        = 14,
+    PICHAU_AURUM_MODE_TIDE          = 15,
+};
+
+/*---------------------------------------------------------*\
+| Settings block stored by the keyboard for each mode.      |
+| Same layout in the 06 16 reply and the 06 0B command,     |
+| starting at byte 7.                                       |
+\*---------------------------------------------------------*/
+struct PichauAurumModeSettings
+{
+    unsigned char mode;
+    unsigned char brightness;   /* 0..4                              */
+    unsigned char speed;        /* 0..2                              */
+    unsigned char direction;    /* kept as read from the keyboard    */
+    unsigned char mono;         /* 1 = single color, 0 = RGB         */
+    unsigned char reserved;     /* unknown, kept as read             */
+    unsigned char hue;
+    unsigned char saturation;
+    unsigned char value;
+
+    bool operator==(const PichauAurumModeSettings& o) const;
+};
+
+class PichauAurumController
+{
+public:
+    PichauAurumController(hid_device* dev_handle, const char* path, std::string dev_name);
+    ~PichauAurumController();
+
+    std::string GetDeviceLocation();
+    std::string GetNameString();
+    std::string GetSerialString();
+
+    bool        ReadCurrentMode(unsigned char* mode);
+    bool        ReadModeSettings(unsigned char mode, PichauAurumModeSettings* settings);
+
+    /*-----------------------------------------------------*\
+    | The keyboard writes every change to flash. Writes are |
+    | deferred until the settings stop changing (e.g. while |
+    | dragging a color picker) and skipped when identical   |
+    | to the last write.                                    |
+    \*-----------------------------------------------------*/
+    void        QueueModeSettings(const PichauAurumModeSettings& settings);
+
+private:
+    hid_device*             dev;
+    std::string             location;
+    std::string             name;
+
+    std::mutex              hid_mutex;
+
+    std::thread             writer_thread;
+    std::mutex              pending_mutex;
+    std::condition_variable pending_cv;
+    bool                    pending_valid;
+    bool                    stop_writer;
+    PichauAurumModeSettings pending;
+    PichauAurumModeSettings last_written;
+    bool                    last_written_valid;
+
+    bool        Command(const unsigned char* data, int length, unsigned char expect, unsigned char* reply);
+    bool        WriteModeSettings(const PichauAurumModeSettings& settings);
+    void        WriterThread();
+};
diff --git a/Controllers/PichauAurumController/PichauAurumControllerDetect.cpp b/Controllers/PichauAurumController/PichauAurumControllerDetect.cpp
